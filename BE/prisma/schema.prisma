generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum RoleName {
  USER
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum EventStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  SUSPENDED
}

enum EventType {
    OFFLINE
    ONLINE
    HYBRID
}

enum ZoneType {
  SEATED
  STANDING
  STAGE
}

// Hình dạng khu vực khi vẽ trên canvas.
enum ZoneShape {
  RECTANGLE
  ROUNDED
  CIRCLE
  ELLIPSE
  TRIANGLE
  DIAMOND
  TRAPEZOID
  POLYGON
}

enum SeatType {
  STANDARD
  VIP
  WHEELCHAIR
}

// Chiều duyệt ghế khi trả vé ngẫu nhiên cho người mua.
enum SeatNumbering {
  ROW
  COLUMN
}

enum TicketTypeStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  BOOKED
  BLOCKED
}

enum SeatMapStatus {
  DRAFT
  READY
  ARCHIVED
}

enum TicketStatus {
  AVAILABLE
  RESERVED
  ISSUED
  CHECKED_IN
  CANCELLED
  REFUNDED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MOMO
  VNPAY
  ZALOPAY
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PostStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  SAD
  ANGRY
}

enum ResaleStatus {
  AVAILABLE
  RESERVED
  SOLD
  CANCELLED
  EXPIRED
}

enum OrganizerRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OrganizerType {
  INDIVIDUAL
  BUSINESS
}

// ==========================================
// MODELS
// ==========================================

model Role {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roleName  RoleName @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  email      String     @unique
  username   String?
  password   String
  roleId     String     @db.ObjectId
  role       Role       @relation(fields: [roleId], references: [id])
  status     UserStatus @default(ACTIVE)
  isVerified Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  profile           UserProfile?
  organizerProfile  OrganizerProfile?
  organizerRequests OrganizerRequest[]
  events            Event[]
  orders            Order[]
  tickets           Ticket[]
  posts             Post[]
  comments          Comment[]
  reactions         Reaction[]
  soldResales       ReSale[] @relation("SellerResales")
  boughtResales     ReSale[] @relation("BuyerResales")
  seatMaps          SeatMap[] @relation("OrganizerSeatMaps")

  @@map("users")
}

model UserProfile {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @unique @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  phone     String?
  dob       DateTime?
  avatar    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("userProfiles")
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@map("categories")
}

model Event {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String      @unique
  description  String?
  thumbnailUrl String?
  bannerUrl    String?

  organizerId String   @db.ObjectId
  organizer   User     @relation(fields: [organizerId], references: [id])
  categoryId  String   @db.ObjectId
  category    Category @relation(fields: [categoryId], references: [id])

  location     String
  eventType    EventType @default(OFFLINE)
  status       EventStatus @default(DRAFT)
  saleStartAt  DateTime?
  saleEndAt    DateTime?
  startAt      DateTime
  endAt        DateTime

  submittedAt  DateTime?
  reviewedAt   DateTime?
  publishedAt  DateTime?
  rejectReason String?

  seatMapId String? @db.ObjectId
  seatMap   SeatMap? @relation("EventSeatMap", fields: [seatMapId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketTypes TicketType[]
  tickets     Ticket[]
  posts       Post[]
  @@index([organizerId])
  @@index([categoryId])
  @@index([status])
  @@index([startAt])
  @@map("events")
}

model SeatMap {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  status  SeatMapStatus @default(DRAFT)

  // Kích thước canvas thiết kế sơ đồ.
  canvasWidth  Float @default(900)
  canvasHeight Float @default(600)

  organizerId String   @db.ObjectId
  organizer   User     @relation("OrganizerSeatMaps", fields: [organizerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones Zone[]
  events Event[] @relation("EventSeatMap")

  @@index([organizerId])
  @@index([status])
  @@map("seatMaps")
}

model Zone {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  seatMapId String   @db.ObjectId
  seatMap   SeatMap  @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  color     String?
  type      ZoneType @default(SEATED)
  capacity  Int      @default(0)
  price     Float    @default(0)
  rowCount  Int      @default(0)
  seatPerRow Int     @default(0)
  isLocked Boolean  @default(false)

  // Hình dạng khu vực trên canvas.
  shape ZoneShape @default(RECTANGLE)

  // Các ô ghế đã bị xoá trong lưới ghế (dùng để giữ các hàng so le).
  // Lưu theo định dạng "rowLabel|seatNumber".
  removedSeats Json? @map("removed_seats")

  // Các ô ghế bị khoá (không bán vé): "rowLabel|seatNumber".
  blockedSeats Json? @map("blocked_seats")

  // Chiều đánh số ghế khi trả vé ngẫu nhiên:
  //  - ROW    -> duyệt theo hàng (A1, A2, A3, B1, B2, ...)
  //  - COLUMN -> duyệt theo cột (A1, B1, C1, A2, B2, ...)
  seatNumbering SeatNumbering @default(ROW) @map("seat_numbering")

  // Tọa độ trên canvas (px theo hệ toạ độ sơ đồ).
  posX      Float    @default(0)
  posY      Float    @default(0)
  width     Float    @default(120)
  height    Float    @default(60)
  rotation  Float    @default(0)

  points Json?
  holes  Json?

  originParts Json? @map("origin_parts")
  combineGroupId String? @map("combine_group_id")

  groupId String? @map("group_id")

  zIndex  Int     @default(0) @map("z_index")

  flipX   Boolean @default(false) @map("flip_x")
  flipY   Boolean @default(false) @map("flip_y")

  level     Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats       Seat[]
  ticketTypes TicketType[]

  @@index([seatMapId])
  @@index([level])
  @@map("zones")
}

model Seat {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  zoneId     String     @db.ObjectId
  zone       Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rowLabel   String
  seatNumber String
  type       SeatType   @default(STANDARD)
  status     SeatStatus @default(AVAILABLE)

  // Toạ độ ghế trong khu vực (tương đối so với zone).
  posX Float @default(0)
  posY Float @default(0)

  // Thứ tự duyệt ghế theo chiều đánh số của khu vực (ROW/COLUMN).
  // Dùng để random trả ghế: các ghế có order liên tiếp luôn
  // nằm gần nhau -> hạn chế sai sót khi khách tìm chỗ ngồi.
  order Int @default(0)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tickets Ticket[]

  @@unique([zoneId, rowLabel, seatNumber])
  @@map("seats")
}

model TicketType {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  eventId      String           @db.ObjectId
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zoneId       String           @db.ObjectId
  zone         Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name         String
  price        Float
  capacity     Int
  soldQuantity Int              @default(0)
  saleStartAt  DateTime?
  saleEndAt    DateTime?
  status       TicketTypeStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  orderItems OrderItem[]
  tickets    Ticket[]

  @@index([eventId])
  @@index([zoneId])
  @@index([status])
  @@map("ticketTypes")
}

model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  orderCode   String      @unique
  userId      String      @db.ObjectId
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Float
  status      OrderStatus @default(PENDING_PAYMENT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orderItems OrderItem[]
  payments   Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  orderId      String     @db.ObjectId
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String     @db.ObjectId
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity     Int
  unitPrice    Float
  subtotal     Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tickets Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
  @@map("orderItems")
}

model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String        @db.ObjectId
  order           Order         @relation(fields: [orderId], references: [id])
  transactionCode String
  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([transactionCode])
  @@map("payments")
}

model Ticket {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  ticketCode   String       @unique
  qrToken      String       @unique
  userId       String       @db.ObjectId
  user         User         @relation(fields: [userId], references: [id])
  eventId      String       @db.ObjectId
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypeId String       @db.ObjectId
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  orderItemId  String?      @db.ObjectId
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id])
  seatId       String?      @db.ObjectId
  seat         Seat?        @relation(fields: [seatId], references: [id])
  status       TicketStatus @default(ISSUED)
  issuedAt     DateTime?
  checkInAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime @updatedAt

  resale ReSale?

  @@index([userId])
  @@index([eventId])
  @@index([ticketTypeId])
  @@index([orderItemId])
  @@index([seatId])
  @@index([status])
  @@map("tickets")
}

model ReSale {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String       @unique @db.ObjectId
  ticket    Ticket       @relation(fields: [ticketId], references: [id])
  sellerId  String       @db.ObjectId
  seller    User         @relation("SellerResales", fields: [sellerId], references: [id])
  buyerId   String?      @db.ObjectId
  buyer     User?        @relation("BuyerResales", fields: [buyerId], references: [id])
  price     Float
  status    ResaleStatus @default(AVAILABLE)
  qrCode    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
  @@map("resales")
}

model Post {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String     @db.ObjectId
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId  String     @db.ObjectId
  author    User       @relation(fields: [authorId], references: [id])
  title     String
  content   String
  status    PostStatus @default(VISIBLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  comments  Comment[]
  reactions Reaction[]

  @@index([eventId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  postId    String        @db.ObjectId
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String        @db.ObjectId
  author    User          @relation(fields: [authorId], references: [id])
  content   String
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([status])
  @@map("comments")
}

model Reaction {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  postId    String       @db.ObjectId
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String       @db.ObjectId
  user      User         @relation(fields: [userId], references: [id])
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([postId, userId])
  @@map("reactions")
}

model SystemSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("systemSettings")
}

model OrganizerProfile {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @unique @db.ObjectId
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizerType    OrganizerType @default(INDIVIDUAL)
  organizationName String
  contactEmail     String
  contactPhone     String
  address          String?
  website          String?
  taxCode          String?
  idCardNumber     String?
  businessLicense  String?
  description      String?
  logo             String?
  banner           String?
  isVerified       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("organizerProfiles")
}

model OrganizerRequest {
  id               String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId           String                 @db.ObjectId
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizerType    OrganizerType          @default(INDIVIDUAL)
  organizationName String
  contactEmail     String
  contactPhone     String
  address          String?
  website          String?
  taxCode          String?
  idCardNumber     String?
  idFrontImage     String?
  idBackImage      String?
  businessLicense  String?
  description      String?
  status           OrganizerRequestStatus @default(PENDING)
  rejectReason     String?
  reviewedBy       String?                @db.ObjectId
  reviewedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("organizerRequests")
}